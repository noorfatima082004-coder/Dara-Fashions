# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cheap, multimodal, free-tier-friendly. Swap to gemini-2.5-flash-lite once
# output quality has been validated for your use case.
GEMINI_MODEL=gemini-2.5-flash

PORT=3000

# Must match the origin the frontend is actually served from (Vite default
# shown below). No wildcard "*" — this endpoint calls a paid API, so CORS is
# the first line of defense against other sites driving it from a browser.
CORS_ORIGIN=http://localhost:5173
